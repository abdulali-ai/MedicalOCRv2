{
  "classify": {
    "document_type": [
      "invoice",
      "medicine_details",
      "discharge_sheet",
      "other_document"
    ]
  },
  "invoice": {
    "instructions": "Output every printed table row and keep consecutive rows that repeat the same code, time, and price as separate items; do not merge them. For net_price always read the صافي السعر column (never سعر الوحدة / unit price). In summary, read الإجمالي for total and الصافي for net without copying net into total when a discount is present. Return null for any field or summary/section_total row not printed on the page (such as room when blank, run_date, user, or summary rows that appear on another page); never copy patient name or admission_no into room.",
    "hospital_name": "verbatim-string",
    "document_title": "verbatim-string",
    "print_date": "verbatim-string",
    "patient": {
      "name": "verbatim-string",
      "admission_no": "verbatim-string",
      "medical_no": "verbatim-string",
      "status": "verbatim-string"
    },
    "payer": "verbatim-string",
    "agreement": "verbatim-string",
    "doctor": "verbatim-string",
    "specialty": "verbatim-string",
    "room": {
      "number": null,
      "type": null
    },
    "stay": {
      "from_date": "verbatim-string",
      "from_time": "verbatim-string",
      "to_date": "verbatim-string",
      "to_time": "verbatim-string"
    },
    "sections": [
      {
        "section_name": "verbatim-string",
        "items": [
          {
            "code": "verbatim-string",
            "description": "verbatim-string",
            "quantity": 0,
            "date": "verbatim-string",
            "time": "verbatim-string",
            "net_price": 0.0,
            "patient_share": 0.0,
            "payer_share": 0.0
          }
        ],
        "section_total": {
          "net_price": null,
          "patient_share": null,
          "payer_share": null
        }
      }
    ],
    "summary": {
      "total": {"value": null, "payer_share": null, "patient_share": null},
      "medical_service": {"value": null, "payer_share": null, "patient_share": null},
      "discount": {"value": null, "payer_share": null, "patient_share": null},
      "vat": {"value": null, "payer_share": null, "patient_share": null},
      "stamp_duty": {"value": null, "payer_share": null, "patient_share": null},
      "net": {"value": null, "payer_share": null, "patient_share": null}
    },
    "run_date": null,
    "user": null
  },
  "id_card": {
    "card_number": "verbatim-string",
