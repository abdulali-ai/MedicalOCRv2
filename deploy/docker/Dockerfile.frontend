FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY frontend/server.mjs ./server.mjs
COPY frontend/package.json ./package.json
ENV PORT=3000
ENV API_TARGET=http://api:5000
EXPOSE 3000
CMD ["node", "server.mjs"]
